<launch>
  <arg name="launch_gazebo" default="false"/>
  <param
    name="robot_description"
    command="$(find xacro)/xacro '$(find quad_manipulator_description)/urdf/quad_manipulator_sim.xacro'" />
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>
    <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher">
        <param name="use_gui" value="True"/>
    </node>

  <include file="$(find robot_inertia_publisher)/launch/robot_inertia_publisher.launch"/>
  <node
    name="rviz"
    pkg="rviz"
    type="rviz"
    args="-d $(find quad_manipulator_description)/rviz/rviz_configure.rviz" />
  <group if="$(arg launch_gazebo)">
    <!-- vehicle pose -->
    <arg name="x" default="0"/>
    <arg name="y" default="0"/>
    <arg name="z" default="0.23"/>
    <arg name="R" default="0"/>
    <arg name="P" default="0"/>
    <arg name="Y" default="0"/>
    <arg name="vehicle" value="quad_manipulator"/>
    <!-- Gazebo sim -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="gui" value="true"/>
        <arg name="verbose" value="true"/>
        <arg name="paused" value="false"/>
    </include>
    <!-- gazebo model -->
    <node name="spawn_quad_manip" pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-urdf -param robot_description -model $(arg vehicle) -x $(arg x) -y $(arg y) -z $(arg z) -R $(arg R) -P $(arg P) -Y $(arg Y)"/>
  </group>
</launch>
