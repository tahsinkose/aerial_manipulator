<?xml version="1.0"?>

<launch>
    <arg name="use_zero_noise_model" default="true"/>
    <group ns="uav1">
        <arg name="fcu_url" default="udp://:14540@localhost:14580"/>
        <include file="$(find quad_manipulator_gazebo)/launch/internal/bringup.launch" >
            <arg name="tf_prefix" value="uav1" />
            <arg name="x" value="16.0" />
            <arg name="y" value="-1.0" />
            <arg name="yaw" value="0.0" />
            <arg name="ID" value="0"/>
            <arg name="fcu_url" value="$(arg fcu_url)"/>
            <arg name="mavlink_udp_port" value="14560"/>
            <arg name="mavlink_tcp_port" value="4560"/>
            <arg name="use_zero_noise_model" value="$(arg use_zero_noise_model)"/>
        </include>
    </group>
    <group ns="uav2">
        <arg name="fcu_url" default="udp://:14541@localhost:14581"/>
        <include file="$(find quad_manipulator_gazebo)/launch/internal/bringup.launch" >
            <arg name="tf_prefix" value="uav2" />
            <arg name="x" value="16.0" />
            <arg name="y" value="1.0" />
            <arg name="yaw" value="0.0" />
            <arg name="ID" value="1"/>
            <arg name="fcu_url" value="$(arg fcu_url)"/>
            <arg name="mavlink_udp_port" value="14561"/>
            <arg name="mavlink_tcp_port" value="4561"/>
            <arg name="use_zero_noise_model" value="$(arg use_zero_noise_model)"/>
        </include>
    </group>
    <group ns="uav3">
        <arg name="fcu_url" default="udp://:14542@localhost:14582"/>
        <include file="$(find quad_manipulator_gazebo)/launch/internal/bringup.launch" >
            <arg name="tf_prefix" value="uav3" />
            <arg name="x" value="12.0" />
            <arg name="y" value="1.0" />
            <arg name="yaw" value="0.0" />
            <arg name="ID" value="2"/>
            <arg name="fcu_url" value="$(arg fcu_url)"/>
            <arg name="mavlink_udp_port" value="14562"/>
            <arg name="mavlink_tcp_port" value="4562"/>
            <arg name="use_zero_noise_model" value="$(arg use_zero_noise_model)"/>
        </include>
    </group>
    <group ns="uav4">
        <arg name="fcu_url" default="udp://:14543@localhost:14583"/>
        <include file="$(find quad_manipulator_gazebo)/launch/internal/bringup.launch" >
            <arg name="tf_prefix" value="uav4" />
            <arg name="x" value="12.0" />
            <arg name="y" value="-1.0" />
            <arg name="yaw" value="0.0" />
            <arg name="ID" value="3"/>
            <arg name="fcu_url" value="$(arg fcu_url)"/>
            <arg name="mavlink_udp_port" value="14563"/>
            <arg name="mavlink_tcp_port" value="4563"/>
            <arg name="use_zero_noise_model" value="$(arg use_zero_noise_model)"/>
        </include>
    </group>
</launch>