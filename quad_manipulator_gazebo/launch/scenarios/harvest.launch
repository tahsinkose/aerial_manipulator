<?xml version="1.0"?>
<launch>
  <arg name="world_dir" value="$(find quad_manipulator_gazebo)/worlds/apple_garden" />
  <arg name="world" value="$(arg world_dir)/apple_garden.world"/>
  <include file="$(find quad_manipulator_gazebo)/launch/internal/sim.launch">
    <arg name="world" value="$(arg world)"/>
  </include>
  <include file="$(find quad_manipulator_gazebo)/launch/internal/spawn_drones.launch"/>
  <include file="$(find quad_manipulator_gazebo)/launch/reco/fruit_detection.launch"/>
</launch>