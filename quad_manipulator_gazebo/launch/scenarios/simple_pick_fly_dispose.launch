<?xml version="1.0"?>
<launch>
  <include file="$(find quad_manipulator_gazebo)/launch/sim.launch">
    <arg name="world" value="$(find quad_manipulator_gazebo)/worlds/workout.world"/>
    <arg name="use_plot_juggler" value="false"/>
  </include>
  <group ns="uav1">
      <arg name="fcu_url" default="udp://:14540@localhost:14580"/>
      <include file="$(find quad_manipulator_gazebo)/launch/single_uav.launch" >
          <arg name="tf_prefix" value="uav1" />
          <arg name="x" value="0.0" />
          <arg name="y" value="0.0" />
          <arg name="z" value="0.3" />
          <arg name="yaw" value="0.0" />
          <arg name="ID" value="0"/>
          <arg name="fcu_url" value="$(arg fcu_url)"/>
          <arg name="mavlink_udp_port" value="14560"/>
          <arg name="mavlink_tcp_port" value="4560"/>
          <arg name="use_zero_noise_model" value="true"/>
      </include>
       <node name="simple_pick_fly_dispose" pkg="quad_manipulator_control" type="simple_pick_fly_dispose" output="screen"/>
  </group>
</launch>