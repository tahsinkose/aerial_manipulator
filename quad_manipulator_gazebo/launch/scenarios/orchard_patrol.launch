<?xml version="1.0"?>
<launch>
  <arg name="world" default="$(find quad_manipulator_gazebo)/worlds/apple_garden_random.world"/>
  <!--Depends on the loaded world file-->
  <rosparam file="$(find quad_manipulator_gazebo)/cfg/patrol.yaml" command="load"/>
  <include file="$(find quad_manipulator_gazebo)/launch/internal/sim.launch">
    <arg name="use_plot_juggler" value="false"/>
    <arg name="world" value="$(arg world)"/>
  </include>
  <group ns="uav1">
    <include file="$(find quad_manipulator_gazebo)/launch/internal/bringup.launch">
      <arg name="tf_prefix" value="uav1" />
      <arg name="x" value="10.0" />
      <arg name="y" value="0.0" />
      <arg name="yaw" value="3.14" />
      <arg name="use_zero_noise_model" value="true"/>
    </include>
    <node name="general_orchard_patrol" pkg="quad_manipulator_control" type="general_orchard_patrol"
       output="screen"/>
  </group>
</launch>