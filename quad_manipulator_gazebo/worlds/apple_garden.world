<?xml version="1.0"?>
<sdf version="1.4">
  <world name="default">
     <gui fullscreen='0'>
      <camera name='developer_camera'>
        <pose frame=''>26.4076 0.083329 5.38427 -0 0.448249 3.10046</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
    <scene>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
    </scene>
    <physics name='default_physics' default='0' type='ode'>
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>1000</iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    </physics>
    <!-- Ground Plane -->
    <include>
      <uri>model://orchard_ground</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>
    <population name="orchard1">
      <model name="apple_tree">
        <include>
          <static>true</static>
          <uri>model://apple_tree</uri>
        </include>
      </model>
      <pose>5 0 0 0 0 0</pose>
      <distribution>
        <type>grid</type>
        <rows>4</rows>
        <cols>4</cols>
        <step>4 4 0</step>
      </distribution>
    </population>
    <population name="orchard2">
      <model name="apple_tree_2">
        <include>
          <static>true</static>
          <uri>model://apple_tree_2</uri>
        </include>
      </model>
      <pose>-5 0 0 0 0 0</pose>
      <distribution>
        <type>grid</type>
        <rows>4</rows>
        <cols>4</cols>
        <step>4 4 0</step>
      </distribution>
    </population>
    <include>
      <uri>model://orchard_wall</uri>
      <name>wall1</name>
      <pose>0.56 16.05 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://orchard_wall</uri>
      <name>wall2</name>
      <pose>0.56 -16.05 0 0 0 0</pose>
    </include>
  </world>
</sdf>
