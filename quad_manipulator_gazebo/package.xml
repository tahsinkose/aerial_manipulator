<package format="2">
  <name>quad_manipulator_gazebo</name>
  <version>0.1.0</version>
  <description>quad_manipulator_gazebo</description>
  <maintainer email="tahsincankose@gmail.com">tahsinkose</maintainer>

  <license>BSD</license>

  <author email="zhonghang@hnu.edu.cn">zhonghang</author>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>gazebo_dev</depend>
  <depend>gazebo_plugins</depend>
  <depend>quad_manipulator_msgs</depend>
  <build_depend>message_generation</build_depend>
  <exec_depend>gazebo</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros_control</exec_depend>
  <exec_depend>quad_manipulator_control</exec_depend>
